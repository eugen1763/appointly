# Generate each secret with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BETTER_AUTH_SECRET=
GUEST_TOKEN_SECRET=

APP_URL=http://localhost:3000
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_PATH=./data/appointly.sqlite
TRUST_PROXY=false

# Google OAuth callback for local development:
# http://localhost:3000/api/auth/callback/google
# Google OAuth callback for production:
# ${APP_URL}/api/auth/callback/google
# For a shared internal/development instance without sign-in, set
# GOOGLE_AUTH_ENABLED=false. Google credentials may then be left blank.
